generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Bài tập trong thư viện
model Exercise {
  id              String              @id @default(cuid())
  name            String              @unique
  nameEn          String?
  muscleGroup     String              // chest, back, legs, shoulders, arms, core, cardio, fullbody
  primaryMuscle   String?             // ngực trên, lưng xô, đùi trước...
  equipment       String?             // barbell, dumbbell, machine, bodyweight, cable
  category        String              @default("strength") // strength, cardio, stretching
  instructions    String?
  videoUrl        String?             // YouTube hoặc bất kỳ URL video nào
  videoStartSec   Int?                // bắt đầu video ở giây nào (cho YouTube)
  isCustom        Boolean             @default(false)
  createdAt       DateTime            @default(now())

  workoutExercises WorkoutExercise[]
  templateExercises TemplateExercise[]

  @@index([muscleGroup])
}

// Một buổi tập (workout session)
model Workout {
  id          String              @id @default(cuid())
  name        String              @default("Buổi tập")
  notes       String?
  startedAt   DateTime            @default(now())
  finishedAt  DateTime?
  durationSec Int?                // thời gian tổng buổi tập
  templateId  String?
  template    Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  exercises   WorkoutExercise[]

  @@index([startedAt])
}

// Một bài tập trong buổi tập
model WorkoutExercise {
  id          String     @id @default(cuid())
  workoutId   String
  workout     Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id])
  order       Int        @default(0)
  notes       String?
  restSeconds Int        @default(90) // thời gian nghỉ mặc định (giây)
  sets        SetEntry[]

  @@index([workoutId])
}

// Một set của bài tập
model SetEntry {
  id                 String          @id @default(cuid())
  workoutExerciseId  String
  workoutExercise    WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber          Int             // 1, 2, 3...
  reps               Int?
  weight             Float?          // kg
  rpe                Float?          // độ khó 1-10
  durationSec        Int?            // cho cardio/plank
  distance           Float?          // km cho cardio
  isWarmup           Boolean         @default(false)
  isCompleted        Boolean         @default(true)
  completedAt        DateTime        @default(now())

  @@index([workoutExerciseId])
}

// Template buổi tập (Push/Pull/Leg, Upper/Lower...)
model Template {
  id          String              @id @default(cuid())
  name        String
  description String?
  emoji       String?             @default("💪")
  exercises   TemplateExercise[]
  workouts    Workout[]
  createdAt   DateTime            @default(now())
}

model TemplateExercise {
  id          String   @id @default(cuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  order       Int      @default(0)
  defaultSets Int      @default(3)
  defaultReps Int      @default(10)
  restSeconds Int      @default(90)

  @@index([templateId])
}

// Theo dõi chỉ số cơ thể
model BodyMetric {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  weight           Float?   // kg
  height           Float?   // cm
  age              Int?     // tuổi
  gender           String?  // "male" | "female"
  bodyFat          Float?   // %
  muscle           Float?   // kg cơ
  chest            Float?   // cm vòng ngực
  waist            Float?   // cm vòng eo
  hip              Float?   // cm vòng mông
  arm              Float?   // cm vòng tay
  thigh            Float?   // cm vòng đùi
  waterPercent     Float?   // % nước cơ thể
  visceralFat      Float?   // chỉ số mỡ nội tạng
  boneMineralKg    Float?   // kg khoáng chất xương
  proteinKg        Float?   // kg protein cơ thể
  skeletalMuscleKg Float?   // kg cơ xương
  notes            String?

  @@index([date])
}

// Nhật ký ăn uống (calories & macros)
model FoodLog {
  id                 String   @id @default(cuid())
  date               DateTime @default(now())
  name               String
  servingDescription String?  // ví dụ: "3 quả trứng (~180g)"
  calories           Float?   // kcal
  protein            Float?   // g
  fat                Float?   // g
  carbs              Float?   // g
  fiber              Float?   // g
  healthyScore       Float?   // điểm healthy từ 0-10
  mealType           String   @default("other") // breakfast, lunch, dinner, snack, other
  notes              String?

  @@index([date])
}

// Mục tiêu dinh dưỡng theo ngày
model NutritionGoal {
  id          String   @id @default(cuid())
  date        DateTime
  calories    Float?   // kcal
  protein     Float?   // g
  fat         Float?   // g
  carbs       Float?   // g
  fiber       Float?   // g
  waterGoalMl  Int?     // ml nước mục tiêu trong ngày
  waterLogMl   Int?     @default(0) // ml nước đã uống trong ngày
  caloriesOut  Int?     // calo tiêu thụ trong ngày
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// Template mục tiêu dinh dưỡng (ngày đi tập / ngày nghỉ)
model NutritionGoalTemplate {
  id          String   @id @default(cuid())
  type        String   @unique // "workout_day" | "rest_day"
  name        String
  calories    Float?
  protein     Float?
  fat         Float?
  carbs       Float?
  fiber       Float?
  waterGoalMl Int?     @default(2000) // ml nước mục tiêu
  updatedAt   DateTime @updatedAt
}
